---
import Base from '../layouts/Base.astro';
---

<Base title='Not found'>
    <section class='hero'>
        <div class='wrap'>
            <p class='label'>404</p>
            <h1 class='display' style='margin-top: 0.75rem'>Wrong <span class='hl'>turn</span></h1>
            <p class='lede'>That page is not here. It may have moved when a project was renamed.</p>
            <div class='actions'>
                <a class='btn btn-action' href='/projects/'>Browse projects</a>
                <a class='btn btn-secondary' href='/'>Home</a>
            </div>
        </div>
    </section>
</Base>
