---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts } from '../../lib/blog';

export async function getStaticPaths() {
    const posts = await getPosts();
    return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
    post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, summary, date, updated, author, tags } = post.data;
const { Content } = await render(post);

// The projects this post is about, in the order the post lists them. An unknown slug is skipped.
const allProjects = await getCollection('projects');
const related = post.data.projects
    .map((slug) => allProjects.find((project) => project.id === slug))
    .filter((project) => project !== undefined);
---

<Base title={title} description={summary} current='blog' type='article'>
    <section class='hero' style='padding-block: 3rem'>
        <div class='wrap'>
            <p class='label'><a href='/blog/' style='color: inherit; text-decoration: none'>Blog</a></p>
            <h1 style='margin-top: 0.6rem; max-width: 52rem'>{title}</h1>
            <p class='faint' style='margin: 1rem 0 0'>
                <time class='data' datetime={date.toISOString()}>{formatDate(date)}</time>
                · {author}
                {updated && <span> · updated <time class='data' datetime={updated.toISOString()}>{formatDate(updated)}</time></span>}
            </p>
        </div>
    </section>

    <div class='wrap project-layout'>
        <article class='prose'>
            <Content />
        </article>

        <aside class='facts panel' aria-label='About this post'>
            <dl>
                {
                    related.length > 0 && (
                        <div>
                            <dt>Projects in this post</dt>
                            <dd style='flex-direction: column; gap: 0.5rem'>
                                {related.map((project) => (
                                    <a href={`/projects/${project.id}/`}>{project.data.title}</a>
                                ))}
                            </dd>
                        </div>
                    )
                }
                {
                    tags.length > 0 && (
                        <div>
                            <dt>Tags</dt>
                            <dd>
                                {tags.map((tag) => (
                                    <span class='chip'>{tag}</span>
                                ))}
                            </dd>
                        </div>
                    )
                }
            </dl>
            <a class='btn btn-secondary' href='/blog/'>All posts</a>
        </aside>
    </div>
</Base>
