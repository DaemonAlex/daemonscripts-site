---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { categoryLabels, categoryOrder, sortProjects } from '../../lib/labels';

const projects = (await getCollection('projects')).sort(sortProjects);
---

<Base title='Projects' current='projects' description='Every DaemonScripts project: FiveM scripts for Del Perro Sands, the APEX and AV App platforms, the game panel and our tools.'>
    <section class='hero' style='padding-block: 3rem'>
        <div class='wrap'>
            <p class='label'>All projects</p>
            <h1 style='margin-top: 0.5rem'>Projects</h1>
            <p class='lede' style='margin-bottom: 0'>Pick a project for the full write-up: features, how it works, requirements, installation and commands.</p>
        </div>
    </section>

    <section class='block'>
        <div class='wrap'>
            <label class='sr-only' for='q'>Search projects</label>
            <input id='q' class='search' type='search' placeholder='Search: job, police, NUI, Vue...' autocomplete='off' />
            <div class='tabs' role='group' aria-label='Filter by category'>
                <button class='tab' type='button' data-filter='all' aria-pressed='true'>All</button>
                {
                    categoryOrder.map((category) => (
                        <button class='tab' type='button' data-filter={category} aria-pressed='false'>
                            {categoryLabels[category]}
                        </button>
                    ))
                }
            </div>
            <ul class='cards' id='project-list'>
                {projects.map((project) => <ProjectCard project={project} />)}
            </ul>
            <p id='none' class='faint' hidden>No project matches that search.</p>
        </div>
    </section>
</Base>

<script>
    // Category tabs and search. Without JavaScript every project simply shows.
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tab')];
    const items = [...document.querySelectorAll<HTMLLIElement>('#project-list > li')];
    const search = document.querySelector<HTMLInputElement>('#q')!;
    const none = document.querySelector<HTMLElement>('#none')!;
    let filter = location.hash.slice(1) || 'all';

    function apply() {
        const words = search.value.toLowerCase().split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const item of items) {
            const inCategory = filter === 'all' || item.dataset.category === filter;
            const matches = words.every((word) => item.dataset.search?.includes(word));
            item.hidden = !(inCategory && matches);
            if (!item.hidden) shown++;
        }
        none.hidden = shown > 0;
        for (const tab of tabs) tab.setAttribute('aria-pressed', String(tab.dataset.filter === filter));
    }

    for (const tab of tabs) {
        tab.addEventListener('click', () => {
            filter = tab.dataset.filter ?? 'all';
            history.replaceState(null, '', filter === 'all' ? location.pathname : `#${filter}`);
            apply();
        });
    }
    search.addEventListener('input', apply);
    if (!tabs.some((tab) => tab.dataset.filter === filter)) filter = 'all';
    apply();
</script>
